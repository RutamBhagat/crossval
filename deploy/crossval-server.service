[Unit]
Description=Crossval API server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/crossval/current/apps/server
Environment=NODE_ENV=production
EnvironmentFile=/opt/crossval/server.env
ExecStart=/usr/bin/node /opt/crossval/current/apps/server/dist/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/crossval

[Install]
WantedBy=multi-user.target
