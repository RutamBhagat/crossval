{
  "name": "@crossval/server",
  "type": "module",
  "main": "dist/server.mjs",
  "exports": {
    "./app": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/server.ts --outfile server",
    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "@better-auth/core": "1.6.25",
    "@crossval/auth": "workspace:*",
    "@crossval/db": "workspace:*",
    "@crossval/domain": "workspace:*",
    "@crossval/env": "workspace:*",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/node": "^1.4.5",
    "@elysiajs/openapi": "^1.4.15",
    "@opentelemetry/api": "^1.9.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "csv-parse": "^7.0.2",
    "elysia": "1.4.29"
  },
  "devDependencies": {
    "@crossval/config": "workspace:*",
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.1",
    "typescript": "catalog:"
  }
}
