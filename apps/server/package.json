{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.mjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest",
    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "@crossval/auth": "workspace:*",
    "@crossval/db": "workspace:*",
    "@crossval/domain": "workspace:*",
    "@crossval/env": "workspace:*",
    "@hono/node-server": "^1.19.11",
    "@hono/standard-validator": "^0.4.0",
    "arktype": "catalog:",
    "csv-parse": "^7.0.2",
    "hono": "^4.12.32",
    "rate-limiter-flexible": "^11.2.0"
  },
  "devDependencies": {
    "@crossval/config": "workspace:*",
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  }
}
