# Development
# Dev-only value. Generate a separate production value with: openssl rand -hex 32
API_ORIGIN_TOKEN=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
API_UPSTREAM_URL=http://localhost:8000

# Production
# Set API_UPSTREAM_URL to the public API origin in the production environment.
# Set API_ORIGIN_TOKEN to the same secret as Caddy. Do not use a NEXT_PUBLIC_ name.
